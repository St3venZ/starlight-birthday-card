{
  "$schema": "./edgeone.schema.json",
  "name": "starlight-birthday-card",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "22",
  "routes": [
    {
      "source": "/c/*",
      "destination": "/index.html"
    },
    {
      "source": "/create",
      "destination": "/index.html"
    }
  ]
}
